APP_NAME=NCRI API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://ncri:ncri_dev_password@localhost:5432/ncri
MAX_UPLOAD_BYTES=5000000
# Fase berikutnya: REDIS_URL, LLM_PROVIDER, LLM_MODEL, LLM_API_KEY
# LLM — kunci hanya di backend. LLM_PROVIDER: kosong (nonaktif) | fake (contoh deterministik untuk dev) | anthropic
LLM_PROVIDER=
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Auth. Di luar development AUTH_SECRET wajib (>= 32 karakter acak: python -c "import secrets;print(secrets.token_urlsafe(48))")
APP_ENV=development
AUTH_SECRET=
TOKEN_TTL_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Akun demo (hanya APP_ENV=development): admin|analyst|reviewer|viewer@ncri.local, kata sandi DEMO_PASSWORD (default ncri-demo-123)
# Akun admin pertama di lingkungan nyata: python -m app.create_admin email "Nama"
